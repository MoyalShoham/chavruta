# Copy to .env (never commit it). Everything here is optional.

# For live answers, or to record new ones. Without it, recorded answers are replayed.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# replay (default) | record | live
CHAVRUTA_LLM_MODE=replay

# Shabbat and Yom Tov closing: auto (Hebcal times) or closed (to see the closed screen).
CHAVRUTA_CLOSING=auto

# full (default) or demo (a smaller library: Berakhot 2a-13a, Deuteronomy, laws of Shema).
CHAVRUTA_CORPUS=full

# Passwords and the session secret are generated into ./secrets on the first run.
