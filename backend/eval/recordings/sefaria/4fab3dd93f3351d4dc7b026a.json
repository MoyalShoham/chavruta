{"ref": "Zohar, Achrei Mot 60:365", "heRef": "ספר הזהר, אחרי מות ס׳:שס״ה", "sectionRef": "Zohar, Achrei Mot 60", "indexTitle": "Zohar", "heIndexTitle": "ספר הזהר", "categories": ["Kabbalah", "Zohar"], "next": "Zohar, Achrei Mot 61", "sectionNames": ["Chapter", "Paragraph"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Vocalized Zohar, Israel 2013", "license": "unknown", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990035741170205171/NLI", "hasText": true}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "The Zohar; London, Soncino Press, 1933", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH997012945475805171/NLI", "text": "Sometimes it happens that Naamah goes forth to have intercourse with men and a man is linked with her in lust, and then suddenly wakes and clasps his wife though his mind is still full of the lust of his dream. In that case the son so born is of the side of Naamah, and when Lilith goes forth she sees him and knows what has happened, and brings him up like the other children of Naamah, and he is often with her, and she does not kill him."}], "available_versions": [{"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "The Zohar; London, Soncino Press, 1933", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH997012945475805171/NLI"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Vocalized Zohar, Israel 2013", "license": "unknown", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990035741170205171/NLI"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Sulam Edition, Jerusalem 1945", "license": "unknown", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001329911/NLI"}, {"language": "he", "languageFamilyName": "h