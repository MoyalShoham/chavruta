{"ref": "Bava Kamma 55b:19", "heRef": "בבא קמא נ״ה ב:י״ט", "sectionRef": "Bava Kamma 55b", "indexTitle": "Bava Kamma", "heIndexTitle": "בבא קמא", "categories": ["Talmud", "Bavli", "Seder Nezikin"], "next": "Bava Kamma 56a", "sectionNames": ["Daf", "Line"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99", "text": "תניא אמר ר' יהושע ארבעה דברים העושה אותן פטור מדיני אדם וחייב בדיני שמים ואלו הן הפורץ גדר בפני בהמת חבירו והכופף קמתו של חבירו בפני הדליקה והשוכר עדי שקר להעיד והיודע עדות לחבירו ואינו מעיד לו:"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org", "text": " There are four acts for which the offender is exempt from the judgments of Man but liable to the judgments of Heaven.. To break down a fence in front of a neighbour's animal [so that it gets out and does damage], to bend over a neighbour's standing corn in front of a fire, to hire a false witnesses to give evidence [and lie]; and to know of evidence in favour of another and not to testify on his behalf."}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Vocalized Aramaic", "license": "CC-BY-NC", "versionSource": "https://korenpub.co.il/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Aramaic", "license": "CC-BY-NC", "versionSource": "https://korenpub.co.il/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "german", "actualLanguage": "de", "versionTitle": "Talmud Bavli. German trans. by Lazarus Goldschmidt, 1929 [de]", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001042448/NLI"}]}