{"ref": "Mishnah Shabbat 6:4", "heRef": "משנה שבת ו׳:ד׳", "sectionRef": "Mishnah Shabbat 6", "indexTitle": "Mishnah Shabbat", "heIndexTitle": "משנה שבת", "categories": ["Mishnah", "Seder Moed"], "next": "Mishnah Shabbat 7", "sectionNames": ["Chapter", "Mishnah"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads", "text": "לֹא יֵצֵא הָאִישׁ לֹא בְסַיִף, וְלֹא בְקֶשֶׁת, וְלֹא בִתְרִיס, וְלֹא בְאַלָּה, וְלֹא בְרֹמַח. וְאִם יָצָא, חַיָּב חַטָּאת. רַבִּי אֱלִיעֶזֶר אוֹמֵר, תַּכְשִׁיטִין הֵן לוֹ. וַחֲכָמִים אוֹמְרִים, אֵינָן אֶלָּא לִגְנַאי, שֶׁנֶּאֱמַר (ישעיה ב) וְכִתְּתוּ חַרְבוֹתָם לְאִתִּים וַחֲנִיתוֹתֵיהֶם לְמַזְמֵרוֹת, לֹא יִשָּׂא גּוֹי אֶל גּוֹי חֶרֶב וְלֹא יִלְמְדוּ עוֹד מִלְחָמָה. בִּירִית, טְהוֹרָה, וְיוֹצְאִין בָּהּ בְּשַׁבָּת. כְּבָלִים, טְמֵאִין, וְאֵין יוֹצְאִין בָּהֶם בְּשַׁבָּת: \n"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1", "hasText": true}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Mishnah, ed. Romm, Vilna 1913", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001741739"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "english", "act