{"ref": "Mishnah Sukkah 1:1", "heRef": "משנה סוכה א׳:א׳", "sectionRef": "Mishnah Sukkah 1", "indexTitle": "Mishnah Sukkah", "heIndexTitle": "משנה סוכה", "categories": ["Mishnah", "Seder Moed"], "next": "Mishnah Sukkah 2", "sectionNames": ["Chapter", "Mishnah"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads", "text": "סֻכָּה שֶׁהִיא גְבוֹהָה לְמַעְלָה מֵעֶשְׂרִים אַמָּה, פְּסוּלָה. רַבִּי יְהוּדָה מַכְשִׁיר. וְשֶׁאֵינָהּ גְּבוֹהָה עֲשָׂרָה טְפָחִים, וְשֶׁאֵין לָהּ שְׁלֹשָׁה דְּפָנוֹת, וְשֶׁחַמָּתָהּ מְרֻבָּה מִצִּלָּתָהּ, פְּסוּלָה. סֻכָּה יְשָׁנָה, בֵּית שַׁמַּאי פּוֹסְלִין, וּבֵית הִלֵּל מַכְשִׁירִין. וְאֵיזוֹ הִיא סֻכָּה יְשָׁנָה, כָּל שֶׁעֲשָׂאָהּ קֹדֶם לֶחָג שְׁלשִׁים יוֹם. אֲבָל אִם עֲשָׂאָהּ לְשֵׁם חָג, אֲפִלּוּ מִתְּחִלַּת הַשָּׁנָה, כְּשֵׁרָה: \n"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1", "hasText": true}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Mishnah, ed. Romm, Vilna 1913", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001741739"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle":