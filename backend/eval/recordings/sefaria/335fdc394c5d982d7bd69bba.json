{"ref": "Pesach Haggadah, Barech, Birkat Hamazon 22", "heRef": "הגדה של פסח, ברך, ברכת המזון כ״ב", "sectionRef": "Pesach Haggadah, Barech, Birkat Hamazon", "indexTitle": "Pesach Haggadah", "heIndexTitle": "הגדה של פסח", "categories": ["Liturgy", "Haggadah"], "next": "Pesach Haggadah, Barech, Third Cup of Wine", "sectionNames": ["Paragraph"], "versions": [{"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Edition", "license": "CC0", "versionSource": "http://www.sefaria.org/sefaria-edition", "text": "Blessed are You, Lord our God, King of the Universe, the Power, our Father, our King, our Mighty One, our Creator, our Redeemer, our Shaper, our Holy One, the Holy One of Ya'akov, our Shepherd, the Shepherd of Israel, the good King, who does good to all, since on every single day He has done good, He does good, He will do good, to us; He has granted us, He grants us, He will grant us forever - in grace and in kindness, and in mercy, and in relief - rescue and success, blessing and salvation, consolation, provision and relief and mercy and life and peace and all good; and may we not lack any good ever. "}], "available_versions": [{"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Koren Publishers, Jerusalem, 2013", "license": "CC-BY-NC", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990035921980205171/NLI"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Pesach Haggadah", "license": "Public Domain", "versionSource": "http://www.daat.ac.il/daat/shabat/pesach/hagada-2.htm"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Edition", "license": "CC0", "versionSource": "http://www.sefaria.org/sefaria-edition"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "A. Alexander 1787", "license": "Public Domain", "versionSource": "http://onthemainline.blogspot.co.il/2011/04/on-first-english-haggadah-short-summary.html"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "D. Levi, New York, 1837", "license": "Public Domain", "versionSource": "http://web.nli.org.il/sites/NLI/English/gallery/of-israel/haggadot/Pages/new_york.aspx"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Mendes, London, 1862", "license": "Public Domain", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Chicago, 1879", "license": "Public Domain", "versionSource": ""}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Green, 1897", "license": "Public Domain", "versionSource": ""}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "The Yitzchak ben Gedalya haLevi Memorial Haggada [transliteration]", "license": "unknown", "versionSource": "https://www.sefaria.org/texts"}]}