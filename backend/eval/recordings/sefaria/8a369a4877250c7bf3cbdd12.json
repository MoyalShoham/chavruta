{"ref": "Mishnah Rosh Hashanah 2:8", "heRef": "משנה ראש השנה ב׳:ח׳", "sectionRef": "Mishnah Rosh Hashanah 2", "indexTitle": "Mishnah Rosh Hashanah", "heIndexTitle": "משנה ראש השנה", "categories": ["Mishnah", "Seder Moed"], "next": "Mishnah Rosh Hashanah 3", "sectionNames": ["Chapter", "Mishnah"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads", "text": "דְּמוּת צוּרוֹת לְבָנוֹת הָיוּ לוֹ לְרַבָּן גַּמְלִיאֵל בַּטַּבְלָא וּבַכֹּתֶל בַּעֲלִיָּתוֹ, שֶׁבָּהֶן מַרְאֶה אֶת הַהֶדְיוֹטוֹת וְאוֹמֵר, הֲכָזֶה רָאִיתָ אוֹ כָזֶה. מַעֲשֶׂה שֶׁבָּאוּ שְׁנַיִם וְאָמְרוּ, רְאִינוּהוּ שַׁחֲרִית בַּמִּזְרָח וְעַרְבִית בַּמַּעֲרָב. אָמַר רַבִּי יוֹחָנָן בֶּן נוּרִי, עֵדֵי שֶׁקֶר הֵם. כְּשֶׁבָּאוּ לְיַבְנֶה קִבְּלָן רַבָּן גַּמְלִיאֵל. וְעוֹד בָּאוּ שְׁנַיִם וְאָמְרוּ, רְאִינוּהוּ בִזְמַנּוֹ, וּבְלֵיל עִבּוּרוֹ לֹא נִרְאָה, וְקִבְּלָן רַבָּן גַּמְלִיאֵל. אָמַר רַבִּי דוֹסָא בֶּן הַרְכִּינָס, עֵדֵי שֶׁקֶר הֵן, הֵיאָךְ מְעִידִין עַל הָאִשָּׁה שֶׁיָּלְדָה, וּלְמָחָר כְּרֵסָהּ בֵּין שִׁנֶּיהָ. אָמַר לוֹ רַבִּי יְהוֹשֻׁעַ, רוֹאֶה אֲנִי אֶת דְּבָרֶיךָ:  "}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1", "hasText": true}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Mishnah, ed. Romm, Vilna 1913", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001741739"}, {"language": "en", "languageFamilyName": "english", "actu