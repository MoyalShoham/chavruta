{"ref": "Nedarim 40a:1", "heRef": "נדרים מ׳ א:א׳", "sectionRef": "Nedarim 40a", "indexTitle": "Nedarim", "heIndexTitle": "נדרים", "categories": ["Talmud", "Bavli", "Seder Nashim"], "next": "Nedarim 40b", "sectionNames": ["Daf", "Line"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99", "text": "רב חלבו באיש לא איכא דקא אתי אמר להו לא כך היה מעשה בתלמיד אחד מתלמידי ר' עקיבא שחלה לא נכנסו חכמים לבקרו ונכנס ר' עקיבא לבקרו ובשביל שכיבדו וריבצו לפניו חיה א\"ל רבי החייתני יצא ר' עקיבא ודרש כל מי שאין מבקר חולים כאילו שופך דמים"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org", "text": "   There is a story about one of Rabbi Avika's students who became sick. The sages did not come to visit him. Rabbi Akiva came in to visit him, and because he showed him respect and sat in front of him, the student lived. He told him Rabbi, you made me live. Rabbi Akiva left and taught, \"He who does not visit the sick is as one who spills blood\"."}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Vocalized Aramaic", "license": "CC-BY-NC", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Aramaic", "license": "CC-BY-NC", "versionSource": "https://korenpub.co.il/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "german", "actualLanguage": "de", "versionTitle": "Talmud Bavli. German trans. by Lazarus Goldschmidt, 1929 [de]", "license": "Public Domain", "versionSource": null}]}