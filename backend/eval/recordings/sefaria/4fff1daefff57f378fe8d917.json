{"ref": "Mishnah Sotah 5:4", "heRef": "משנה סוטה ה׳:ד׳", "sectionRef": "Mishnah Sotah 5", "indexTitle": "Mishnah Sotah", "heIndexTitle": "משנה סוטה", "categories": ["Mishnah", "Seder Nashim"], "next": "Mishnah Sotah 6", "sectionNames": ["Chapter", "Mishnah"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads", "text": "בּוֹ בַיּוֹם דָּרַשׁ רַבִּי עֲקִיבָא (שמות טו), אָז יָשִׁיר משֶׁה וּבְנֵי יִשְׂרָאֵל אֶת הַשִּׁירָה הַזֹּאת לַה' וַיֹּאמְרוּ לֵאמֹר, שֶׁאֵין תַּלְמוּד לוֹמַר לֵאמֹר, וּמַה תַּלְמוּד לוֹמַר לֵאמֹר, מְלַמֵּד שֶׁהָיוּ יִשְׂרָאֵל עוֹנִין אַחֲרָיו שֶׁל משֶׁה עַל כָּל דָּבָר וְדָבָר, כְּקוֹרִין אֶת הַהַלֵּל, לְכָךְ נֶאֱמַר לֵאמֹר. רַבִּי נְחֶמְיָה אוֹמֵר, כְּקוֹרִין אֶת שְׁמַע וְלֹא כְקוֹרִין אֶת הַהַלֵּל: \n"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1", "hasText": true}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Torat Emet 357", "license": "Public Domain", "versionSource": "http://www.toratemetfreeware.com/index.html?downloads"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Mishnah, ed. Romm, Vilna 1913", "license": "Public Domain", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH001741739"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Mishnah Yomit by Dr. Joshua Kulp", "lic