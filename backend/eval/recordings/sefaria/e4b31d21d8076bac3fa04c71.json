{"ref": "Pesach Haggadah, Barech, Birkat Hamazon 22", "heRef": "הגדה של פסח, ברך, ברכת המזון כ״ב", "sectionRef": "Pesach Haggadah, Barech, Birkat Hamazon", "indexTitle": "Pesach Haggadah", "heIndexTitle": "הגדה של פסח", "categories": ["Liturgy", "Haggadah"], "next": "Pesach Haggadah, Barech, Third Cup of Wine", "sectionNames": ["Paragraph"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Pesach Haggadah", "license": "Public Domain", "versionSource": "http://www.daat.ac.il/daat/shabat/pesach/hagada-2.htm", "text": "בָּרוּךְ אַתָּה יְיָ, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הָאֵל אָבִינוּ מַלְכֵּנוּ אַדִּירֵנוּ בּוֹרְאֵנוּ גּוֹאֲלֵנוּ יוֹצְרֵנוּ קְדוֹשֵׁנוּ קְדוֹשׁ יַעֲקֹב רוֹעֵנוּ רוֹעֵה יִשְׂרָאֵל הַמֶּלֶךְ הַטּוֹב וְהַמֵּטִיב לַכֹּל שֶׁבְּכָל יוֹם וָיוֹם הוּא הֵטִיב, הוּא מֵטִיב, הוּא יֵיטִיב לָנוּ. הוּא גְמָלָנוּ הוּא גוֹמְלֵנוּ הוּא יִגְמְלֵנוּ לָעַד, לְחֵן וּלְחֶסֶד וּלְרַחֲמִים וּלְרֶוַח הַצָּלָה וְהַצְלָחָה, בְּרָכָה וִישׁוּעָה נֶחָמָה פַּרְנָסָה וְכַלְכָּלָה וְרַחֲמִים וְחַיִּים וְשָׁלוֹם וְכָל טוֹב, וּמִכָּל טוּב לְעוֹלָם אַל יְחַסְּרֵנוּ."}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Koren Publishers, Jerusalem, 2013", "license": "CC-BY-NC", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990035921980205171/NLI", "hasText": true}], "available_versions": [{"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Koren Publishers, Jerusalem, 2013", "license": "CC-BY-NC", "versionSource": "https://www.nli.org.il/he/books/NNL_ALEPH990035921980205171/NLI"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Pesach Haggadah", "license": "Public Domain", "versionSource": "http://www.daat.ac.il/daat/shabat/pesach/hagada-2.htm"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Edition", "license": "CC0", "versionSource": "http://www.sefaria.org/sefaria-edition"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "A. Alexander 1787", "license": "Public Domain", "versionSource": "http://onthemainline.blogspot.co.il/2011/04/on-first-english-haggadah-short-summary.html"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "D. Levi, New York, 1837", "license": "Public Domain", "versionSource": "http://web.nli.org.il/sites/NLI/English/gallery/of-israel/haggadot/Pages/new_york.aspx"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Mendes, London, 1862", "license": "Public Domain", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Chicago, 1879", "license": "Public Domain", "versionSource": ""}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Green, 1897", "license": "Public Domain", "versionSource": ""}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "The Yitzchak ben Gedalya haLevi Memorial Haggada [transliteration]", "license": "unknown", "versionSource": "https://www.sefaria.org/texts"}]}