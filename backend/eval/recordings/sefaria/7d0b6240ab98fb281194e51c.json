{"ref": "Taanit 29a:4", "heRef": "תענית כ״ט א:ד׳", "sectionRef": "Taanit 29a", "indexTitle": "Taanit", "heIndexTitle": "תענית", "categories": ["Talmud", "Bavli", "Seder Moed"], "next": "Taanit 29b", "sectionNames": ["Daf", "Line"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99", "text": "וכתיב (במדבר יב, טו) ותסגר מרים שבעת ימים דהוו להו עשרין ותשעה בסיון וכתיב (במדבר יג, ב) שלח לך אנשים"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org", "text": "And it is written, \"And Miriam was quarantined for seven days (Numbers 12:15),\" which gives you the twenty-ninth of Sivan, and it is written, \"Send for yourself men (Numbers 13:2).\""}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Vocalized Aramaic", "license": "CC-BY-NC", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Dav