{"ref": "Bava Batra 11a:2", "heRef": "בבא בתרא י״א א:ב׳", "sectionRef": "Bava Batra 11a", "indexTitle": "Bava Batra", "heIndexTitle": "בבא בתרא", "categories": ["Talmud", "Bavli", "Seder Nezikin"], "next": "Bava Batra 11b", "sectionNames": ["Daf", "Line"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99", "text": "תניא אמרו עליו על בנימין הצדיק שהיה ממונה על קופה של צדקה פעם אחת באתה אשה לפניו בשני בצורת אמרה לו רבי פרנסני אמר לה העבודה שאין בקופה של צדקה כלום אמרה לו רבי אם אין אתה מפרנסני הרי אשה ושבעה בניה מתים עמד ופרנסה משלו לימים חלה ונטה למות אמרו מלאכי השרת לפני הקב\"ה רבש\"ע אתה אמרת כל המקיים נפש אחת מישראל כאילו קיים עולם מלא ובנימין הצדיק שהחיה אשה ושבעה בניה ימות בשנים מועטות הללו מיד קרעו לו גזר דינו תנא הוסיפו לו עשרים ושתים שנה על שנותיו"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org", "text": "              "}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Vocalized Aramaic", "license": "CC-BY-NC", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle":