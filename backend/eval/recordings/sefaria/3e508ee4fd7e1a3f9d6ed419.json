{"ref": "Eruvin 13b:10", "heRef": "עירובין י״ג ב:י׳", "sectionRef": "Eruvin 13b", "indexTitle": "Eruvin", "heIndexTitle": "עירובין", "categories": ["Talmud", "Bavli", "Seder Moed"], "next": "Eruvin 14a", "sectionNames": ["Daf", "Line"], "versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "Wikisource Talmud Bavli", "license": "CC-BY-SA", "versionSource": "http://he.wikisource.org/wiki/%D7%AA%D7%9C%D7%9E%D7%95%D7%93_%D7%91%D7%91%D7%9C%D7%99", "text": "א\"ר אבא אמר שמואל שלש שנים נחלקו ב\"ש וב\"ה הללו אומרים הלכה כמותנו והללו אומרים הלכה כמותנו  יצאה בת קול ואמרה אלו ואלו דברי אלהים חיים הן והלכה כב\"ה"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "Sefaria Community Translation", "license": "CC0", "versionSource": "https://www.sefaria.org", "text": "Rabbi Abba said in the name of Shmuel, For three years, the House of Hillel and the House of Shammai argued. One said, 'The halakha is like us,' and the other said, 'The halakha is like us.' A heavenly voice spoke: \"These and these are the words of the living God, and the halakha is like the House of Hillel.\""}], "available_versions": [{"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Vocalized Aramaic", "license": "CC-BY-NC", "versionSource": "http://sefaria.org"}, {"language": "en", "languageFamilyName": "english", "actualLanguage": "en", "versionTitle": "William Davidson Edition - English", "license": "CC-BY-NC", "versionSource": "https://korenpub.com/collections/the-noe-edition-koren-talmud-bavli-1"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTitle": "William Davidson Edition - Aramaic", "license": "CC-BY-NC", "versionSource": "https://www.korenpub.com/koren_en_usd/koren/talmud/koren-talmud-bavli-no/mskt-eirvbin-hlq-a.html"}, {"language": "he", "languageFamilyName": "hebrew", "actualLanguage": "he", "versionTit